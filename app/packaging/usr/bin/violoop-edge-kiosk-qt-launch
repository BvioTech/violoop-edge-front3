#!/bin/bash
# Production launcher for violoop-edge-kiosk-qt.service. Its default path
# (weston) follows the same weston/seat pattern as violoop-edge-front2's
# packaging/usr/bin/violoop-edge-kiosk-launch and this repo's own app/scripts/launch-under-weston.sh (that one is for
# ad-hoc dev testing with env-var overrides; this is the fixed-path
# version that actually ships in the .deb). Requires the invoking
# systemd unit's PAMName=login + TTYPath=/dev/tty7 for seat/KMS access -
# not meant to run standalone over plain SSH.
set -uo pipefail

QT_PREFIX=/opt/violoop-qt6
BIN=/opt/violoop-edge-kiosk-qt/violoop_edge_kiosk_qt

export LD_LIBRARY_PATH="$QT_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export QML2_IMPORT_PATH="$QT_PREFIX/qml:${QML2_IMPORT_PATH:-}"
export QT_PLUGIN_PATH="$QT_PREFIX/plugins:${QT_PLUGIN_PATH:-}"

export QSG_RHI_BACKEND=opengl

RUN_DIR="${RUNTIME_DIRECTORY:-/run/violoop-edge-kiosk-qt}"
mkdir -p "$RUN_DIR"

# EDGE_KIOSK_QPA (set in /etc/violoop/kiosk-qt) picks how the app reaches
# the screen: "wayland" (the default) starts weston and runs the app as its
# one client; "eglfs" runs the app straight on KMS with no compositor.
# eglfs works but ran the away page about 20% slower on dev1 (44 fps
# against 56), so weston stays the default - see app/README.md,
# "不经 weston（eglfs）".
QPA="${EDGE_KIOSK_QPA:-wayland}"
case "$QPA" in
    wayland|eglfs) ;;
    *)
        # <4> is journald's warning level. A typo here should not leave
        # the kiosk with a black screen, so carry on with the default.
        echo "<4>violoop-edge-kiosk-qt-launch: unknown EDGE_KIOSK_QPA '$QPA', using wayland" >&2
        QPA=wayland
        ;;
esac

if [ "$QPA" = eglfs ]; then
    export QT_QPA_PLATFORM=eglfs
    export QT_QPA_EGLFS_INTEGRATION=eglfs_kms
    # Without a compositor Qt may draw its own mouse pointer when it finds
    # a pointer device. This is a touch-only kiosk.
    export QT_QPA_EGLFS_HIDECURSOR=1
    # /dev/dri/card0 is rockchip-drm, the device that drives DSI-1;
    # /dev/dri/card1 is the Mali render node. Left to itself eglfs_kms
    # picked card1 here and aborted with "no screens available" (see
    # qt3d-spike/docs/findings.md, "EGLFS QPA"), so name the device.
    KMS_CONFIG="$RUN_DIR/eglfs_kms.json"
    printf '{ "device": "/dev/dri/card0" }\n' >"$KMS_CONFIG"
    export QT_QPA_EGLFS_KMS_CONFIG="$KMS_CONFIG"
    exec "$BIN"
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY=wayland-0
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1

rm -f "$XDG_RUNTIME_DIR/wayland-0" "$XDG_RUNTIME_DIR/wayland-0.lock"

# No repaint-window in [core] below, on purpose. The launchers this one
# descends from set repaint-window=-1, which holds every client on this
# 60 Hz panel to 30 fps: weston then starts compositing too late for the
# next refresh, so each frame goes out one refresh behind (measured on
# dev1, 2026-11-13: 28-29 fps with -1 or 0, 46-57 with weston's default of
# 7 ms - see app/README.md, "性能标杆").
WESTON_INI="$RUN_DIR/weston.ini"
cat >"$WESTON_INI" <<INI
[core]
backend=drm-backend.so
require-input=false
idle-time=0
xwayland=false

[shell]
locking=false
panel-position=none

[output]
name=DSI-1
transform=normal
INI

WESTON_LOG="$RUN_DIR/weston.log"
/usr/bin/weston --config="$WESTON_INI" --shell=kiosk-shell.so \
    --socket=wayland-0 --tty=7 --idle-time=0 \
    >"$WESTON_LOG" 2>&1 &
WESTON_PID=$!

for _ in $(seq 1 40); do
    if [ -S "$XDG_RUNTIME_DIR/wayland-0" ] \
       && grep -q "kiosk-shell" "$WESTON_LOG" 2>/dev/null; then
        break
    fi
    sleep 0.25
done
sleep 1

trap 'kill -TERM $WESTON_PID 2>/dev/null' EXIT TERM INT

exec "$BIN"
