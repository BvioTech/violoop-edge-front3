#!/bin/sh
# Mirrors violoop-edge-front2's packaging/debian/postinst (systemd
# daemon-reload pattern, soft-failed, guarded on /run/systemd/system so a
# chroot/container install doesn't try to talk to a systemd that isn't
# running). Also enables and starts violoop-edge-kiosk-qt.service on
# install - we're still pre-production, so it's fine for this package to
# just take the display. It conflicts at the systemd level with the
# production violoop-edge-kiosk.service (violoop-edge-front2): both bind
# the same seat0/tty7, so starting this one stops that one (see this
# unit's Conflicts=). Revisit this default before go-live, per
# violoop-edge-front replacement plan (see control).
set -e

case "$1" in
  configure)
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      systemctl enable --now violoop-edge-kiosk-qt.service || true
    fi
    ;;
esac

exit 0
