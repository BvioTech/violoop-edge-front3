# violoop-edge-kiosk-qt runtime config - consumed as a systemd
# EnvironmentFile (EnvironmentFile=-/etc/violoop/kiosk-qt, leading `-`
# makes a missing file non-fatal) by violoop-edge-kiosk-qt.service, same
# convention as edge-front2's /etc/violoop/kiosk. Separate file (not
# shared with edge-front2's) because two packages owning the same
# conffile is a dpkg hazard even though the keys mean the same thing.

# Same-machine violoop-edge REST+SSE base - see src/RestClient.h.
EDGE_API_BASE=http://127.0.0.1:9090

# violoop-edge-llm (RK1828 local inference, VLA11 only) - separate
# service, not proxied by violoop-edge. See qml/TestLlmModelPage.qml,
# the only consumer. Uncomment only if it differs from the default.
#EDGE_LLM_API_BASE=http://127.0.0.1:8000

# Page to open on top of the home page at startup, for unattended runs
# of some other page - see main.cpp. Leave unset in normal use; a burn-in
# of the 3D mascot needs nothing here, that is the home page.
#EDGE_KIOSK_OPEN_PAGE=TestDisplayPage.qml

# Record the home page's performance readout to a CSV file from startup,
# for the same unattended runs - see src/PerfRecorder.h. Off in
# normal use; SIGUSR2 turns it on and off by hand.
#EDGE_KIOSK_RECORD_PERF=1

# How the app reaches the screen - see /usr/bin/violoop-edge-kiosk-qt-launch.
# "wayland" (the default) runs it under weston; "eglfs" runs it straight on
# KMS with no compositor. eglfs ran the home page about 20% slower on dev1
# and its touch handling has not been checked by hand, so it is here for
# comparison runs, not for normal use.
#EDGE_KIOSK_QPA=eglfs

# Show the mascot in one phase of a voice conversation (connecting,
# listening, thinking, speaking) without starting one, to look at it.
#EDGE_KIOSK_MASCOT_CONVERSATION=listening
